# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 Storage (S3-Compatible Object Storage for Documents)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=pathway-documents
# Optional: if you have configured a custom domain or r2.dev public URL for public assets
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://documents.yourdomain.com
