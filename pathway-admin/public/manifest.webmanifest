{
  "name": "Pathway Admin CRM",
  "short_name": "Pathway",
  "description": "Internal Consultancy Management & Student CRM Suite for Pathway Education",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#FAF8F5",
