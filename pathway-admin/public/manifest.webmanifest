      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Applications",
      "short_name": "Applications",
      "description": "Review university applications pipeline",
      "url": "/applications",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Tasks & Follow-ups",
      "short_name": "Tasks",
      "description": "Daily follow-ups and counselling appointments",
